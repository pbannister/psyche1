# Scratch trees a pipeline or test may create (keep the pattern, not the tree).
.tmp-*
_site/
node_modules/
__pycache__/
*.py[cod]

# Python virtual environment and caches.
.venv/
venv/
.pytest_cache/
*.egg-info/

# An accidental in-source build directory (builds belong in dataflow.out/build).
build/
dist/
